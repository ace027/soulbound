# Anthropic API key (required to run the World Voice routes)
# Get one from https://console.anthropic.com/account/keys
#
# A Claude Pro/Max subscription does NOT include API access — Anthropic bills
# the API separately through Console credits. See docs/MIGRATION-PLAN.md.
#
# PREFER SOULBOUND_ANTHROPIC_KEY over ANTHROPIC_API_KEY when setting this as a
# host or cloud-environment variable: Claude Code uses an ANTHROPIC_API_KEY it
# finds in the environment in preference to a Pro/Max subscription, so the
# ANTHROPIC_API_KEY name would quietly move your own Claude Code usage onto
# billed API credits. docker-compose.yml maps SOULBOUND_ANTHROPIC_KEY into the
# container as ANTHROPIC_API_KEY, which is what the backend reads.
#
# Set ONE of these. SOULBOUND_ANTHROPIC_KEY wins if both are present.
SOULBOUND_ANTHROPIC_KEY=
ANTHROPIC_API_KEY=

# Access passphrase (REQUIRED — the backend refuses to boot without it).
#
# This is a phrase YOU choose and hand out to the players you invite. It is
# NOT your Anthropic key, and it never reaches Anthropic: it's the deployer's
# own gate, so a stranger who finds this server's port can't spend your
# Anthropic credits. The browser asks for it once per device and remembers it.
#
# Must be at least 12 characters, plain ASCII only (a browser cannot send an
# accented letter or an emoji in the header this travels in — anything outside
# printable ASCII fails to boot rather than silently locking every player
# out). A few random words work well, e.g. "correct horse battery staple".
SOULBOUND_PASSPHRASE=

# Optional: only needed if your build host intercepts TLS (e.g. a corporate
# proxy or a sandboxed CI runner). Points at a CA bundle the Docker build
# should trust when installing npm packages. Leave unset on a normal machine.
# Point this at the SPECIFIC intercepting proxy's CA certificate, not a full
# corporate root bundle — it widens the trust anchor used by `npm ci` during
# the Docker build, so keep that widening as narrow as the need.
# NPM_CA_FILE=/path/to/ca-bundle.crt

# ---------------------------------------------------------------------------
# Optional. Both are validated at startup and the backend REFUSES TO BOOT on a
# bad value, so a typo fails loudly rather than silently widening access.
# ---------------------------------------------------------------------------

# Comma-separated Host header allow-list. Defaults to
# localhost:PORT, 127.0.0.1:PORT, [::1]:PORT.
# This is what stops a malicious page using DNS rebinding to drive your
# backend — which spends real API credits — from a site you happen to visit.
# Set it if you change the published port or front the backend with a reverse
# proxy; otherwise the first symptom is a blanket 403 on every /api/* call.
# docker-compose.yml already sets this, and must include the `backend:3001`
# service name for Vite's proxy. `*` is rejected.
# ALLOWED_HOSTS=localhost:3001,127.0.0.1:3001,[::1]:3001,backend:3001

# Origin allowed by CORS. Defaults to http://localhost:5173.
# Must be a parseable absolute origin; `*` is rejected, because combined with
# the lack of auth it would make the paid proxy callable and readable by any
# website.
# FRONTEND_ORIGIN=http://localhost:5173

# Requests per minute allowed per client against /api/*, before the access
# gate's rate limiter answers 429. Defaults to 30. Must be an integer from 1
# to 600; the backend refuses to boot on anything else.
# RATE_LIMIT_PER_MINUTE=30

# Trust level for a reverse proxy in front of this backend, forwarded to
# Express's `trust proxy` setting so rate limiting reads the real client IP
# from X-Forwarded-For instead of the proxy's own address. Defaults to false
# (no proxy trusted; every request appears to come from one address). Accepts
# 'loopback', 'uniquelocal', or an integer hop count (1-5). `true` is
# rejected: trusting every hop lets any caller spoof a fresh IP, and a fresh
# rate-limit bucket, on every request when nothing is actually proxying.
#
# Set this ONLY when a real reverse proxy (nginx, Caddy, a cloud load
# balancer, ...) sits in front of this backend and is KNOWN to OVERWRITE (not
# append to) X-Forwarded-For with the real client address on every request.
# Otherwise leave it unset. In particular: plain Docker published-port
# networking (`-p 3001:3001`, or this project's own docker-compose.yml) is
# NOT such a proxy — a connection arriving via a published port comes from
# the Docker bridge gateway, a private 172.x address that 'uniquelocal' (and
# hop-count 1) both classify as "trusted", but nothing in that path touches
# application-layer headers. A caller can set X-Forwarded-For directly and
# Express will believe it, defeating the rate limiter while req.ip still
# looks plausible in a log line. If you set this at all, prefer the smallest
# hop count matching your actual proxy chain over 'uniquelocal', which trusts
# any number of private-range hops.
# TRUST_PROXY=loopback
