{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    // The backend runs as plain Node ESM (`type: module`, `node dist/server.js`),
    // which requires explicit .js extensions on relative imports. The base
    // config's `bundler` resolution does not enforce that, so tsc could pass on
    // code Node then rejects with ERR_MODULE_NOT_FOUND. frontend/ and shared/
    // stay on `bundler` since their output is bundled.
    "moduleResolution": "node16",
    "module": "node16",
    "outDir": "./dist",
    "rootDir": "./src",
    "types": ["node"]
  },
  "include": ["src/**/*"]
}
