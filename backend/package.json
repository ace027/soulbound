{
  "name": "@soulbound/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput & node --watch dist/server.js",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "tracker:test": "node dist/scripts/trackerTest.js",
    "migrate": "node dist/migrate.js",
    "invite:create": "node dist/scripts/createInvite.js",
    "test:hosted": "vitest run -c vitest.hosted.config.ts --reporter=default --reporter=json --outputFile=.vitest-hosted.json && node scripts/assert-no-skips.mjs .vitest-hosted.json"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.126.0",
    "@sentry/node": "^11.0.0",
    "@soulbound/shared": "*",
    "better-auth": "1.7.6",
    "express": "^5.2.1",
    "node-pg-migrate": "9.0.0",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.23.1",
    "typescript": "^5.7.2",
    "vitest": "^5.0.1"
  }
}
